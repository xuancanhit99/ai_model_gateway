--
-- Name: api_keys Allow individual user delete access; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow individual user delete access" ON public.api_keys FOR DELETE USING ((auth.uid() = user_id));


--
-- Name: user_provider_keys Allow individual user delete access for their provider keys; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow individual user delete access for their provider keys" ON public.user_provider_keys FOR DELETE USING ((auth.uid() = user_id));


--
-- Name: api_keys Allow individual user insert access; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow individual user insert access" ON public.api_keys FOR INSERT WITH CHECK ((auth.uid() = user_id));


--
-- Name: user_provider_keys Allow individual user insert access for their provider keys; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow individual user insert access for their provider keys" ON public.user_provider_keys FOR INSERT WITH CHECK ((auth.uid() = user_id));


--
-- Name: api_keys Allow individual user read access; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow individual user read access" ON public.api_keys FOR SELECT USING ((auth.uid() = user_id));


--
-- Name: user_provider_keys Allow individual user read access to their provider keys; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow individual user read access to their provider keys" ON public.user_provider_keys FOR SELECT USING ((auth.uid() = user_id));


--
-- Name: api_keys Allow individual user update access; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow individual user update access" ON public.api_keys FOR UPDATE USING ((auth.uid() = user_id)) WITH CHECK ((auth.uid() = user_id));


--
-- Name: user_provider_keys Allow individual user update access for their provider keys; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow individual user update access for their provider keys" ON public.user_provider_keys FOR UPDATE USING ((auth.uid() = user_id)) WITH CHECK (((auth.uid() = user_id) AND (provider_name = ( SELECT upk.provider_name
   FROM public.user_provider_keys upk
  WHERE (upk.id = user_provider_keys.id)))));


--
-- Name: provider_key_logs Users can insert their own logs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can insert their own logs" ON public.provider_key_logs FOR INSERT WITH CHECK ((auth.uid() = user_id));


--
-- Name: provider_key_logs Users can view their own logs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can view their own logs" ON public.provider_key_logs FOR SELECT USING ((auth.uid() = user_id));


